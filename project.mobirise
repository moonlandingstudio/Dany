        {
          "_name": "list01",
          "_sourceTheme": "devicem5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 60px",
                "@media (max-width: 1440px)": {
                  "padding": "0 42px"
                },
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "96px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "48px"
                }
              }
            },
            ".panel-group": {
              ".card": {
                "border-radius": "0 !important",
                "padding": "24px 0",
                "border-bottom": "1px solid @border",
                "&:first-child": {
                  "border-top": "1px solid @border"
                },
                ".card-header": {
                  "padding": "0",
                  "border": "none",
                  "background-color": "transparent",
                  ".panel-title": {
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "space-between",
                    "&:not(.collapsed)": {
                      ".icon-wrapper": {
                        ".mbr-iconfont": {
                          "transform": "rotate(135deg)"
                        }
                      }
                    },
                    ".panel-wrap": {
                      "display": "flex",
                      "align-items": "center",
                      "width": "80%",
                      "@media (max-width: 992px)": {
                        "width": "100%"
                      },
                      ".panel-number": {
                        "min-width": "210px",
                        "margin-bottom": "0",
                        "@media (max-width: 992px)": {
                          "display": "none"
                        }
                      },
                      ".panel-title-edit": {
                        "width": "100%",
                        "margin-bottom": "0"
                      }
                    },
                    ".icon-wrapper": {
                      "margin-left": "16px",
                      ".mbr-iconfont": {
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "width": "40px",
                        "height": "40px",
                        "min-width": "40px",
                        "font-size": "32px",
                        "color": "@icon",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "display": "flex",
                    "padding-top": "16px",
                    ".panel-padding": {
                      "min-width": "210px",
                      "@media (max-width: 992px)": {
                        "display": "none"
                      }
                    },
                    ".panel-text": {
                      "width": "60%",
                      "margin-bottom": "0",
                      "opacity": ".7",
                      "@media (max-width: 768px)": {
                        "width": "80%"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#e48065",
              "text-align": "center"
            },
            ".panel-number": {
              "color": "#5a6b5d"
            },
            ".panel-title-edit": {
              "color": "#232323"
            },
            ".panel-text": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section class=\"list01 devicem5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Number\" name=\"showNumber\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#7b8c82\" name=\"border\" selected>\n        <input type=\"color\" title=\"Icon Color\" value=\"#7b8c82\" name=\"icon\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-7.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fcfcfc\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-7.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><span style=\"font-weight: normal;\">\n                        PREGUNTAS FRECUENTES</span></h2>\n                </div>\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <div class=\"panel-wrap\">\n                                    <p class=\"panel-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-number\" mbr-if=\"showNumber\">\n                                        01\n                                    </p>\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">¿Cuánto cuesta un tatuaje?</h4>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <div class=\"panel-padding\"></div>\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b><br>El precio depende del tamaño, la complejidad del diseño y el tiempo necesario para realizarlo, la cotización es personalizada.</b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <div class=\"panel-wrap\">\n                                    <p class=\"panel-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-number\" mbr-if=\"showNumber\">\n                                        02\n                                    </p>\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">¿Cómo agendo una cita?</h4>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <div class=\"panel-padding\"></div>\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>\n                                    Puedes contactarme a través de WhatsApp o en el botón de \"Cotizar\"</b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <div class=\"panel-wrap\">\n                                    <p class=\"panel-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-number\" mbr-if=\"showNumber\">\n                                        03\n                                    </p>\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">¿Duele mucho un tatuaje?</h4>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <div class=\"panel-padding\"></div>\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>\n                                    La experiencia varía según la ubicación y el diseño. No te preocupes yo te guiaré para minimizar cualquier incomodidad.\n                                </b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <div class=\"panel-wrap\">\n                                    <p class=\"panel-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-number\" mbr-if=\"showNumber\">\n                                        04\n                                    </p>\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">¿Es seguro tatuarse?</h4>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <div class=\"panel-padding\"></div>\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>\n                                    ¡Por supuesto! Uso equipo esterilizado y desechable, cumpliendo con los estándares de higiene.\n                                </b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <div class=\"panel-wrap\">\n                                    <p class=\"panel-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-number\" mbr-if=\"showNumber\">\n                                        05\n                                    </p>\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">¿Cómo debo cuidar mi tatuaje después de hacerlo?</h4>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <div class=\"panel-padding\"></div>\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\"><b>\n                                    Te proporcionaré instrucciones detalladas para el cuidado. Generalmente, incluye lavar suavemente el área, aplicar crema específica y evitar la exposición al sol, agua de albercas y rascarte.\n                                </b></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <div class=\"panel-wrap\">\n                                    <p class=\"panel-number mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-number\" mbr-if=\"showNumber\">\n                                        06\n                                    </p>\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".panel-title-edit\">\n                                        What are the key differences between iOS and Android?\n                                    </h4>\n                                </div>\n                                <div class=\"icon-wrapper\">\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                </div>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <div class=\"panel-padding\"></div>\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    iOS is exclusive to Apple devices, offering a closed ecosystem known for its\n                                    uniformity and security. Android, used by various manufacturers, provides more\n                                    customization options and an open ecosystem. Each has its strengths, so the choice\n                                    often depends on user preference.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "list01-7c",
          "_isUserblock": true,
          "_cid": "uy7mhTVIAr",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor"
          },
          "_name": "content2",
          "_sourceTheme": "hotelm4",
          "_customHTML": "<section class=\"mbr-section content2 hotelm4_content2\" group=\"Content\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Arriba\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Abajo\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Color de Fondo\" name=\"bgColor\" value=\"#fcfcfc\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-10\">\n                <div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-secondary\" href=\"Contacto.html\" data-app-placeholder=\"Type Text\">COTIZA AQUÍ</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content2-7s",
          "_isUserblock": true,
          "_cid": "uy7y7zr6FT",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden"
          },
          "_name": "footer2",
          "_sourceTheme": "talkm5",
          "_customHTML": "<section class=\"talkm5 footer2\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\t\t<input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2-1.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#5a6b5d\" selected>\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#2e481a\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"media-container-row align-center mbr-white\">\n\t\t\t<div class=\"col-12\">\n\t\t\t\t<p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">Copyright 2025 Dany Arias<br>Todos los derechos reservados&nbsp;<br>Desarrollo web - <a href=\"https://moonlandingstudio.com.mx/\" class=\"text-danger\" target=\"_blank\">Moon Landing Studio</a></p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
