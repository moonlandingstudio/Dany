          "_name": "content2",
          "_sourceTheme": "hotelm4",
          "_customHTML": "<section class=\"mbr-section content2 hotelm4_content2\" group=\"Content\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Arriba\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Abajo\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"color\" title=\"Color de Fondo\" name=\"bgColor\" value=\"#fcfcfc\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-10\">\n                <div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-secondary\" href=\"https://wa.me/5537013248\" data-app-placeholder=\"Type Text\">WhatsApp&nbsp;</a>\n                    <a class=\"btn btn-lg btn-secondary\" href=\"https://www.instagram.com/direct/t/105176980880904\" data-app-placeholder=\"Type Text\" target=\"_blank\">DM Instagram</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
