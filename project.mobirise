        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background-color": "@bgColor",
            ".counter-container": {
              "ul": {
                "margin-bottom": "0",
                "li": {
                  "margin-bottom": "1rem",
                  "& when (@stylizedCounters)": {
                    "list-style": "none",
                    "position": "relative",
                    "&:before": {
                      "position": "absolute",
                      "left": "-56px",
                      "margin-top": "-10px",
                      "padding-top": "2px",
                      "padding-left": "1px",
                      "content": "''",
                      "display": "inline-block",
                      "text-align": "center",
                      "margin": "5px 10px",
                      "line-height": "20px",
                      "transition": "all 0.2s",
                      "color": "contrast(@counterColor)",
                      "background": "@counterColor",
                      "width": "25px",
                      "height": "25px",
                      "border-radius": "50%",
                      "& when (@countersType = 'circle')": {
                        "background": "none",
                        "border": "1px solid @counterColor",
                        "color": "@counterColor"
                      },
                      "& when (@countersType = 'square')": {
                        "border-radius": "0"
                      },
                      "& when (@mark)": {
                        "content": "'✓'"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-text": {
              "color": "#1a1818"
            },
            ".mbr-text UL": {
              "text-align": "left"
            }
          },
          "_name": "content8",
          "_sourceTheme": "hotelm4",
          "_customHTML": "<section class=\"mbr-section article content8 hotelm4_content8\" group=\"Content\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Arriba\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Abajo\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n\n        <input type=\"checkbox\" title=\"Viñetas Personalizadas\" name=\"stylizedCounters\" checked>\n        <input type=\"color\" title=\"Color de Viñetas\" name=\"counterColor\" value=\"#5a6b5d\" condition=\"stylizedCounters\">\n        <input type=\"checkbox\" title=\"Viñetas Personalizadas\" name=\"stylizedCounters\" checked>\n        <input type=\"checkbox\" title=\"Marca\" name=\"mark\" checked condition=\"stylizedCounters\">\n        <select title=\"Tipo de Viñetas\" name=\"countersType\" condition=\"stylizedCounters\">\n            <option value=\"default\">Círculo con Relleno</option>\n            <option value=\"circle\">Círculo</option>\n            <option value=\"square\" selected>Cuadrado</option>\n        </select>\n        <input type=\"color\" title=\"Color de Fondo\" name=\"bgColor\" value=\"#fcfcfc\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"mbr-text counter-container col-12 col-md-10 col-lg-8 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                <ul>\n                    <li><b>Datos de contacto (Nombre, celular).</b></li><li><b style=\"font-size: 0.8rem;\">Descripción detallada de tu idea con fotos de referencia para ejemplificar.</b></li><li><b style=\"font-size: 0.8rem;\">Tamaño aproximado en cm. (Ejemplo&nbsp; 5 x 5 x cm)</b><br></li><li><b style=\"font-size: 0.8rem;\">Zona del cuerpo donde quieres el tatuaje (Brazo, pierna, espalda,etc.)</b></li><li><b style=\"font-size: 0.8rem;\">Significado. (Cuéntame qué hace este diseño especial para ti )</b></li><li><b style=\"font-size: 0.8rem;\">Inspiración. (Envíame imagenes de referencia o estilos que te gusten)</b></li>\n                </ul>\n            </div>\n        </div>\n    </div>\n</section>",
